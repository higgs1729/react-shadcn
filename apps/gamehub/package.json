{
  "name": "@react-shadcn/gamehub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "stats:deploy": "wrangler --config stats-worker/wrangler.jsonc deploy",
    "stats:migrate:local": "wrangler --config stats-worker/wrangler.jsonc d1 migrations apply react-shadcn-gamehub-stats --local",
    "stats:migrate:remote": "wrangler --config stats-worker/wrangler.jsonc d1 migrations apply react-shadcn-gamehub-stats --remote",
    "upload:assets": "node scripts/upload-assets.mjs",
    "upload:assets:check": "node scripts/upload-assets.mjs --check",
    "checks": "npm run lint && npm run typecheck && npm run build",
    "test": "npm run build && node --test tests/rendered-html.test.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.92.0"
  },
  "type": "module"
}

# Patterns are intentionally unanchored: every app under apps/* produces its own
# node_modules, .next, out and test-results.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage
test-results
playwright-report

# next.js
.next/
out/

# production
build
dist/

# misc
.DS_Store
*.pem
/sampleforYou/
/.artifacts/

# Ad-hoc design-QA screenshots agents drop next to the app they were checking.
# They are throwaway evidence for one review, not assets; five of them had been
# sitting untracked in apps/portal/. Commit real assets under public/ instead.
design-qa-*.png

# Team T preview images live in Cloudflare R2, not here — they are the heaviest
# thing the repo carried and they grow with every new game. These directories
# are now a staging area: drop a new preview in, run `npm -w apps/team-t run
# upload:assets`, and scripts/asset-manifest.json records what the bucket holds.
# Ignoring them is what stops the images from drifting back into git one commit
# at a time; `npm run validate` fails if a page names a preview the bucket lacks.
apps/team-t/public/game-previews/
apps/team-t/public/api-page-previews/
apps/portal/public/app-previews/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static
docs/examples/checks-latest.json

# temporary working space
tmp/

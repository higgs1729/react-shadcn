# Patterns are intentionally unanchored: every app under apps/* produces its own
# node_modules, .next, out and test-results.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage
test-results
playwright-report

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem
/sampleforYou/
/.artifacts/

# Ad-hoc design-QA screenshots agents drop next to the app they were checking.
# They are throwaway evidence for one review, not assets; five of them had been
# sitting untracked in apps/portal/. Commit real assets under public/ instead.
design-qa-*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static
docs/examples/checks-latest.json

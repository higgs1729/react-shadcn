{
  "name": "@react-shadcn/shadcn-kit",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "shadcn/ui (base-ui, style base-vega) primitives, theme tokens and shared hooks for the shadcn-based apps in this monorepo.",
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "checks": "npm run lint && npm run typecheck"
  },
  "exports": {
    "./ui/*": "./components/ui/*.tsx",
    "./components/*": "./components/*.tsx",
    "./lib/*": "./lib/*.ts",
    "./hooks/*": "./hooks/*.ts",
    "./styles/*": "./styles/*"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@shadcn/react": "^0.2.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "10.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "storybook": "10.5.0",
    "typescript": "^5"
  }
}
